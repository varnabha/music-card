{"chaand-baaliyan": "<div class=\"sp-art\" aria-hidden=\"true\">\n          <div class=\"sp-art-sky\">\n            <div class=\"sp-art-stars\"></div>\n            <div class=\"sp-art-glow\"></div>\n          </div>\n          <svg class=\"sp-moon\" viewBox=\"0 0 200 200\">\n            <defs>\n              <radialGradient id=\"spMoonFill\" cx=\"38%\" cy=\"35%\" r=\"65%\">\n                <stop offset=\"0%\" stop-color=\"#fff8ea\" />\n                <stop offset=\"45%\" stop-color=\"#f0e2c4\" />\n                <stop offset=\"100%\" stop-color=\"#c9b48a\" />\n              </radialGradient>\n            </defs>\n            <circle cx=\"100\" cy=\"100\" r=\"62\" fill=\"url(#spMoonFill)\" />\n            <circle cx=\"128\" cy=\"88\" r=\"54\" fill=\"#0c1220\" />\n          </svg>\n          <svg class=\"sp-earring sp-earring-r\" viewBox=\"0 0 60 120\">\n            <path\n              d=\"M30 8 C30 8 18 22 18 38 C18 52 30 60 30 60 C30 60 42 52 42 38 C42 22 30 8 30 8 Z\"\n              fill=\"none\"\n              stroke=\"#e8d5a3\"\n              stroke-width=\"1.6\"\n            />\n            <circle cx=\"30\" cy=\"8\" r=\"3.2\" fill=\"#f2e6c4\" />\n            <circle cx=\"30\" cy=\"70\" r=\"6.5\" fill=\"none\" stroke=\"#d4af6a\" stroke-width=\"1.4\" />\n            <path\n              d=\"M30 77 Q23 90 30 102 Q37 90 30 77\"\n              fill=\"none\"\n              stroke=\"#e8d5a3\"\n              stroke-width=\"1.2\"\n            />\n            <circle cx=\"30\" cy=\"106\" r=\"2.8\" fill=\"#d4af6a\" />\n          </svg>\n        </div>", "saiyaan": "<div class=\"sp-art\" aria-hidden=\"true\">\n          <div class=\"sp-art-sky\">\n            <div class=\"sp-art-haze\"></div>\n            <div class=\"sp-art-glow\"></div>\n          </div>\n          <!-- Original cover: dusk diya + moths (Sufi beloved / flame) -->\n          <svg class=\"sp-cover\" viewBox=\"0 0 240 240\" xmlns=\"http://www.w3.org/2000/svg\">\n            <defs>\n              <radialGradient id=\"flameCore\" cx=\"50%\" cy=\"70%\" r=\"55%\">\n                <stop offset=\"0%\" stop-color=\"#fff6d8\" />\n                <stop offset=\"35%\" stop-color=\"#ffb347\" />\n                <stop offset=\"75%\" stop-color=\"#ff7a28\" />\n                <stop offset=\"100%\" stop-color=\"#c44a12\" />\n              </radialGradient>\n              <radialGradient id=\"lampBody\" cx=\"40%\" cy=\"30%\" r=\"70%\">\n                <stop offset=\"0%\" stop-color=\"#f3d9a8\" />\n                <stop offset=\"55%\" stop-color=\"#c9954a\" />\n                <stop offset=\"100%\" stop-color=\"#7a4e1e\" />\n              </radialGradient>\n              <linearGradient id=\"petalGold\" x1=\"0\" y1=\"0\" x2=\"1\" y2=\"1\">\n                <stop offset=\"0%\" stop-color=\"#f3d9a8\" stop-opacity=\"0.9\" />\n                <stop offset=\"100%\" stop-color=\"#e8b86d\" stop-opacity=\"0.35\" />\n              </linearGradient>\n            </defs>\n\n            <!-- soft lotus / garland arcs -->\n            <path d=\"M48 168 Q120 128 192 168\" fill=\"none\" stroke=\"url(#petalGold)\" stroke-width=\"1.4\" opacity=\"0.7\" />\n            <path d=\"M58 178 Q120 146 182 178\" fill=\"none\" stroke=\"#e8b86d\" stroke-width=\"1\" opacity=\"0.35\" />\n\n            <!-- left moth -->\n            <g transform=\"translate(58 78) rotate(-18)\" fill=\"#f3d9a8\" opacity=\"0.75\">\n              <ellipse cx=\"0\" cy=\"0\" rx=\"11\" ry=\"6\" transform=\"rotate(-28)\" />\n              <ellipse cx=\"14\" cy=\"-2\" rx=\"11\" ry=\"6\" transform=\"rotate(28)\" />\n              <ellipse cx=\"7\" cy=\"2\" rx=\"3\" ry=\"5\" fill=\"#e8b86d\" />\n            </g>\n            <!-- right moth -->\n            <g transform=\"translate(178 92) rotate(22)\" fill=\"#f3d9a8\" opacity=\"0.65\">\n              <ellipse cx=\"0\" cy=\"0\" rx=\"9\" ry=\"5\" transform=\"rotate(-30)\" />\n              <ellipse cx=\"12\" cy=\"-1\" rx=\"9\" ry=\"5\" transform=\"rotate(28)\" />\n              <ellipse cx=\"6\" cy=\"1.5\" rx=\"2.5\" ry=\"4\" fill=\"#e8b86d\" />\n            </g>\n\n            <!-- flame -->\n            <ellipse cx=\"120\" cy=\"118\" rx=\"18\" ry=\"36\" fill=\"url(#flameCore)\" />\n            <ellipse cx=\"120\" cy=\"126\" rx=\"8\" ry=\"16\" fill=\"#fff8e8\" opacity=\"0.85\" />\n\n            <!-- diya bowl -->\n            <path\n              d=\"M78 148 C78 148 88 168 120 168 C152 168 162 148 162 148 C162 148 150 156 120 156 C90 156 78 148 78 148 Z\"\n              fill=\"url(#lampBody)\"\n            />\n            <ellipse cx=\"120\" cy=\"148\" rx=\"42\" ry=\"10\" fill=\"#f3d9a8\" />\n            <ellipse cx=\"120\" cy=\"146\" rx=\"28\" ry=\"5\" fill=\"#7a4e1e\" opacity=\"0.35\" />\n            <!-- wick -->\n            <rect x=\"117.5\" y=\"132\" width=\"5\" height=\"14\" rx=\"1.5\" fill=\"#3a2814\" />\n\n            <!-- floating petals -->\n            <ellipse cx=\"86\" cy=\"198\" rx=\"10\" ry=\"5\" fill=\"#e8b86d\" opacity=\"0.45\" transform=\"rotate(-20 86 198)\" />\n            <ellipse cx=\"154\" cy=\"202\" rx=\"9\" ry=\"4.5\" fill=\"#f3d9a8\" opacity=\"0.4\" transform=\"rotate(18 154 202)\" />\n            <ellipse cx=\"120\" cy=\"208\" rx=\"8\" ry=\"4\" fill=\"#e8b86d\" opacity=\"0.35\" />\n          </svg>\n        </div>", "i-think-they-call-this-love": "<div class=\"sp-art\" aria-hidden=\"true\">\n          <div class=\"sp-art-sky\">\n            <div class=\"sp-art-rain\"></div>\n            <div class=\"sp-art-stars\"></div>\n            <div class=\"sp-art-glow\"></div>\n          </div>\n          <!-- Night-window acoustic: guitar silhouette + warm string glow -->\n          <svg class=\"sp-cover\" viewBox=\"0 0 240 240\" xmlns=\"http://www.w3.org/2000/svg\">\n            <defs>\n              <radialGradient id=\"lampWarm\" cx=\"70%\" cy=\"28%\" r=\"45%\">\n                <stop offset=\"0%\" stop-color=\"#fff4d6\" stop-opacity=\"0.95\" />\n                <stop offset=\"45%\" stop-color=\"#f0c27a\" stop-opacity=\"0.55\" />\n                <stop offset=\"100%\" stop-color=\"#f0c27a\" stop-opacity=\"0\" />\n              </radialGradient>\n              <linearGradient id=\"bodyWood\" x1=\"0.2\" y1=\"0\" x2=\"0.85\" y2=\"1\">\n                <stop offset=\"0%\" stop-color=\"#6b5340\" />\n                <stop offset=\"55%\" stop-color=\"#4a3a2c\" />\n                <stop offset=\"100%\" stop-color=\"#3a2e24\" />\n              </linearGradient>\n              <linearGradient id=\"stringGlow\" x1=\"0\" y1=\"0\" x2=\"0\" y2=\"1\">\n                <stop offset=\"0%\" stop-color=\"#fff0d0\" />\n                <stop offset=\"100%\" stop-color=\"#f6d9a8\" stop-opacity=\"0.55\" />\n              </linearGradient>\n              <linearGradient id=\"windowPane\" x1=\"0\" y1=\"0\" x2=\"1\" y2=\"1\">\n                <stop offset=\"0%\" stop-color=\"#1e3548\" stop-opacity=\"0.55\" />\n                <stop offset=\"100%\" stop-color=\"#0c1822\" stop-opacity=\"0.2\" />\n              </linearGradient>\n            </defs>\n\n            <!-- soft window frame hint -->\n            <rect x=\"28\" y=\"22\" width=\"184\" height=\"148\" rx=\"4\" fill=\"url(#windowPane)\" stroke=\"#9bb3a6\" stroke-opacity=\"0.25\" stroke-width=\"1.2\" />\n            <line x1=\"120\" y1=\"22\" x2=\"120\" y2=\"170\" stroke=\"#9bb3a6\" stroke-opacity=\"0.18\" stroke-width=\"1\" />\n            <line x1=\"28\" y1=\"96\" x2=\"212\" y2=\"96\" stroke=\"#9bb3a6\" stroke-opacity=\"0.15\" stroke-width=\"1\" />\n\n            <!-- lamp glow through glass -->\n            <circle cx=\"168\" cy=\"58\" r=\"42\" fill=\"url(#lampWarm)\" />\n\n            <!-- acoustic guitar (slightly tilted) -->\n            <g transform=\"translate(118 128) rotate(-18)\">\n              <!-- body -->\n              <ellipse cx=\"0\" cy=\"28\" rx=\"38\" ry=\"46\" fill=\"url(#bodyWood)\" />\n              <ellipse cx=\"0\" cy=\"18\" rx=\"26\" ry=\"18\" fill=\"#2a2218\" opacity=\"0.45\" />\n              <!-- sound hole -->\n              <circle cx=\"0\" cy=\"18\" r=\"11\" fill=\"#1a1510\" />\n              <circle cx=\"0\" cy=\"18\" r=\"13\" fill=\"none\" stroke=\"#f6d9a8\" stroke-opacity=\"0.55\" stroke-width=\"1.2\" />\n              <!-- bridge -->\n              <rect x=\"-12\" y=\"42\" width=\"24\" height=\"4\" rx=\"1\" fill=\"#8a7058\" />\n              <!-- neck -->\n              <rect x=\"-5\" y=\"-78\" width=\"10\" height=\"88\" rx=\"2\" fill=\"#5a4636\" />\n              <!-- headstock -->\n              <path d=\"M-8 -78 L8 -78 L10 -98 L-10 -98 Z\" fill=\"#4a3a2c\" />\n              <circle cx=\"-4\" cy=\"-90\" r=\"1.6\" fill=\"#fff0d0\" opacity=\"0.85\" />\n              <circle cx=\"4\" cy=\"-90\" r=\"1.6\" fill=\"#fff0d0\" opacity=\"0.85\" />\n              <circle cx=\"-4\" cy=\"-84\" r=\"1.6\" fill=\"#f6d9a8\" opacity=\"0.75\" />\n              <circle cx=\"4\" cy=\"-84\" r=\"1.6\" fill=\"#f6d9a8\" opacity=\"0.75\" />\n              <!-- glowing strings -->\n              <g stroke=\"url(#stringGlow)\" stroke-width=\"1\" opacity=\"0.95\">\n                <line x1=\"-3\" y1=\"-76\" x2=\"-3\" y2=\"44\" />\n                <line x1=\"-1\" y1=\"-76\" x2=\"-1\" y2=\"44\" />\n                <line x1=\"1\" y1=\"-76\" x2=\"1\" y2=\"44\" />\n                <line x1=\"3\" y1=\"-76\" x2=\"3\" y2=\"44\" />\n              </g>\n            </g>\n\n            <!-- soft sill / notes hint -->\n            <path d=\"M36 188 Q120 168 204 188\" fill=\"none\" stroke=\"#9bb3a6\" stroke-opacity=\"0.28\" stroke-width=\"1.2\" />\n            <ellipse cx=\"58\" cy=\"198\" rx=\"7\" ry=\"3.5\" fill=\"#f0c27a\" opacity=\"0.25\" transform=\"rotate(-18 58 198)\" />\n            <ellipse cx=\"178\" cy=\"202\" rx=\"6\" ry=\"3\" fill=\"#9bb3a6\" opacity=\"0.3\" transform=\"rotate(14 178 202)\" />\n          </svg>\n        </div>", "cant-help-falling-in-love": "<div class=\"sp-art\" aria-hidden=\"true\">\n          <div class=\"sp-art-sky\">\n            <div class=\"sp-art-rain\"></div>\n            <div class=\"sp-art-stars\"></div>\n            <div class=\"sp-art-glow\"></div>\n          </div>\n          <!-- Soft room glow + cute cat -->\n          <svg class=\"sp-cover\" viewBox=\"0 0 240 240\" xmlns=\"http://www.w3.org/2000/svg\">\n            <defs>\n              <radialGradient id=\"catGlow\" cx=\"50%\" cy=\"40%\" r=\"55%\">\n                <stop offset=\"0%\" stop-color=\"#f2e6d4\" stop-opacity=\"0.55\" />\n                <stop offset=\"60%\" stop-color=\"#8eb4c8\" stop-opacity=\"0.12\" />\n                <stop offset=\"100%\" stop-color=\"#8eb4c8\" stop-opacity=\"0\" />\n              </radialGradient>\n              <linearGradient id=\"catFur\" x1=\"0.3\" y1=\"0\" x2=\"0.8\" y2=\"1\">\n                <stop offset=\"0%\" stop-color=\"#f7efe4\" />\n                <stop offset=\"55%\" stop-color=\"#e8d5b5\" />\n                <stop offset=\"100%\" stop-color=\"#c9b08a\" />\n              </linearGradient>\n              <linearGradient id=\"catShade\" x1=\"0\" y1=\"0\" x2=\"1\" y2=\"1\">\n                <stop offset=\"0%\" stop-color=\"#d4bf9a\" />\n                <stop offset=\"100%\" stop-color=\"#a89070\" />\n              </linearGradient>\n            </defs>\n\n            <circle cx=\"120\" cy=\"110\" r=\"78\" fill=\"url(#catGlow)\" />\n\n            <!-- soft floor oval -->\n            <ellipse cx=\"120\" cy=\"188\" rx=\"62\" ry=\"12\" fill=\"#8eb4c8\" opacity=\"0.18\" />\n\n            <!-- cute sitting cat -->\n            <g transform=\"translate(120 128)\">\n              <!-- tail -->\n              <path\n                d=\"M42 28 C68 18 74 -8 52 -22\"\n                fill=\"none\"\n                stroke=\"#e8d5b5\"\n                stroke-width=\"10\"\n                stroke-linecap=\"round\"\n              />\n              <path\n                d=\"M42 28 C68 18 74 -8 52 -22\"\n                fill=\"none\"\n                stroke=\"#c9b08a\"\n                stroke-width=\"5\"\n                stroke-linecap=\"round\"\n                opacity=\"0.55\"\n              />\n\n              <!-- body -->\n              <ellipse cx=\"0\" cy=\"34\" rx=\"38\" ry=\"32\" fill=\"url(#catFur)\" />\n              <ellipse cx=\"8\" cy=\"40\" rx=\"22\" ry=\"18\" fill=\"url(#catShade)\" opacity=\"0.35\" />\n\n              <!-- front paws -->\n              <ellipse cx=\"-14\" cy=\"58\" rx=\"11\" ry=\"7\" fill=\"#f2e6d4\" />\n              <ellipse cx=\"14\" cy=\"58\" rx=\"11\" ry=\"7\" fill=\"#f2e6d4\" />\n\n              <!-- head -->\n              <circle cx=\"0\" cy=\"-8\" r=\"28\" fill=\"url(#catFur)\" />\n\n              <!-- ears -->\n              <path d=\"M-24 -22 L-34 -48 L-8 -30 Z\" fill=\"#e8d5b5\" />\n              <path d=\"M-24 -24 L-30 -42 L-12 -30 Z\" fill=\"#f7c9c4\" opacity=\"0.85\" />\n              <path d=\"M24 -22 L34 -48 L8 -30 Z\" fill=\"#e8d5b5\" />\n              <path d=\"M24 -24 L30 -42 L12 -30 Z\" fill=\"#f7c9c4\" opacity=\"0.85\" />\n\n              <!-- cheeks -->\n              <circle cx=\"-16\" cy=\"-2\" r=\"7\" fill=\"#f7c9c4\" opacity=\"0.45\" />\n              <circle cx=\"16\" cy=\"-2\" r=\"7\" fill=\"#f7c9c4\" opacity=\"0.45\" />\n\n              <!-- eyes (happy closed) -->\n              <path d=\"M-14 -8 Q-9 -13 -4 -8\" fill=\"none\" stroke=\"#3a2e24\" stroke-width=\"2.2\" stroke-linecap=\"round\" />\n              <path d=\"M4 -8 Q9 -13 14 -8\" fill=\"none\" stroke=\"#3a2e24\" stroke-width=\"2.2\" stroke-linecap=\"round\" />\n\n              <!-- nose + smile -->\n              <ellipse cx=\"0\" cy=\"2\" rx=\"3.2\" ry=\"2.4\" fill=\"#d9898a\" />\n              <path d=\"M0 4 Q-5 10 -10 7\" fill=\"none\" stroke=\"#3a2e24\" stroke-width=\"1.5\" stroke-linecap=\"round\" />\n              <path d=\"M0 4 Q5 10 10 7\" fill=\"none\" stroke=\"#3a2e24\" stroke-width=\"1.5\" stroke-linecap=\"round\" />\n\n              <!-- whiskers -->\n              <g stroke=\"#3a2e24\" stroke-opacity=\"0.35\" stroke-width=\"1\" stroke-linecap=\"round\">\n                <line x1=\"-8\" y1=\"4\" x2=\"-34\" y2=\"0\" />\n                <line x1=\"-8\" y1=\"7\" x2=\"-34\" y2=\"8\" />\n                <line x1=\"8\" y1=\"4\" x2=\"34\" y2=\"0\" />\n                <line x1=\"8\" y1=\"7\" x2=\"34\" y2=\"8\" />\n              </g>\n\n              <!-- tiny heart float -->\n              <g transform=\"translate(36 -36) scale(0.45)\" fill=\"#f2e6d4\" opacity=\"0.9\">\n                <path d=\"M0 8 C-8 -2 -16 -2 -16 4 C-16 10 -4 16 0 20 C4 16 16 10 16 4 C16 -2 8 -2 0 8 Z\" />\n              </g>\n            </g>\n          </svg>\n        </div>", "saudebaazi": "<div class=\"sp-art\" aria-hidden=\"true\">\n          <div class=\"sp-art-sky\">\n            <div class=\"sp-art-rain\"></div>\n            <div class=\"sp-art-stars\"></div>\n            <div class=\"sp-art-glow\"></div>\n          </div>\n          <!-- User-provided rose graphic -->\n          <img class=\"sp-cover\" src=\"assets/rose.png\" alt=\"\" width=\"1024\" height=\"1024\" />\n        </div>", "kabhi-jo-badal-barse": "<div class=\"sp-art\" aria-hidden=\"true\">\n          <div class=\"sp-art-sky\">\n            <div class=\"sp-art-rain\"></div>\n            <div class=\"sp-art-stars\"></div>\n            <div class=\"sp-art-glow\"></div>\n          </div>\n          <!-- Night window \u00b7 violet monsoon rain on glass -->\n          <svg class=\"sp-cover\" viewBox=\"0 0 240 240\" xmlns=\"http://www.w3.org/2000/svg\">\n            <defs>\n              <linearGradient id=\"nightViolet\" x1=\"0\" y1=\"0\" x2=\"0\" y2=\"1\">\n                <stop offset=\"0%\" stop-color=\"#3a1a68\" />\n                <stop offset=\"35%\" stop-color=\"#241048\" />\n                <stop offset=\"70%\" stop-color=\"#120828\" />\n                <stop offset=\"100%\" stop-color=\"#080414\" />\n              </linearGradient>\n              <radialGradient id=\"horizonV\" cx=\"50%\" cy=\"0%\" r=\"70%\">\n                <stop offset=\"0%\" stop-color=\"#8a60c8\" stop-opacity=\"0.55\" />\n                <stop offset=\"55%\" stop-color=\"#503088\" stop-opacity=\"0.2\" />\n                <stop offset=\"100%\" stop-color=\"#503088\" stop-opacity=\"0\" />\n              </radialGradient>\n              <radialGradient id=\"moonSoft\" cx=\"50%\" cy=\"50%\" r=\"50%\">\n                <stop offset=\"0%\" stop-color=\"#f8f0ff\" />\n                <stop offset=\"45%\" stop-color=\"#d8c4f0\" stop-opacity=\"0.7\" />\n                <stop offset=\"100%\" stop-color=\"#a080d0\" stop-opacity=\"0\" />\n              </radialGradient>\n              <linearGradient id=\"cloudBand\" x1=\"0\" y1=\"0\" x2=\"0\" y2=\"1\">\n                <stop offset=\"0%\" stop-color=\"#e8dcf8\" stop-opacity=\"0.55\" />\n                <stop offset=\"40%\" stop-color=\"#9a80c0\" stop-opacity=\"0.4\" />\n                <stop offset=\"100%\" stop-color=\"#4a3870\" stop-opacity=\"0.15\" />\n              </linearGradient>\n              <linearGradient id=\"glassTint\" x1=\"0\" y1=\"0\" x2=\"1\" y2=\"1\">\n                <stop offset=\"0%\" stop-color=\"#c8b0e8\" stop-opacity=\"0.06\" />\n                <stop offset=\"100%\" stop-color=\"#080414\" stop-opacity=\"0.2\" />\n              </linearGradient>\n              <linearGradient id=\"dropGlass\" x1=\"0\" y1=\"0\" x2=\"0\" y2=\"1\">\n                <stop offset=\"0%\" stop-color=\"#ffffff\" stop-opacity=\"0.55\" />\n                <stop offset=\"100%\" stop-color=\"#c8b0e8\" stop-opacity=\"0.15\" />\n              </linearGradient>\n              <filter id=\"blurSoft\" x=\"-10%\" y=\"-10%\" width=\"120%\" height=\"120%\">\n                <feGaussianBlur stdDeviation=\"1.4\" />\n              </filter>\n            </defs>\n\n            <!-- sky beyond the glass -->\n            <rect width=\"240\" height=\"240\" fill=\"url(#nightViolet)\" />\n            <rect width=\"240\" height=\"240\" fill=\"url(#horizonV)\" />\n\n            <!-- distant moon -->\n            <circle cx=\"168\" cy=\"48\" r=\"26\" fill=\"url(#moonSoft)\" opacity=\"0.85\" />\n            <circle cx=\"168\" cy=\"48\" r=\"14\" fill=\"#f0e8fc\" opacity=\"0.9\" />\n            <circle cx=\"174\" cy=\"44\" r=\"12\" fill=\"#241048\" opacity=\"0.35\" />\n\n            <!-- far cloud layer \u2014 soft, adult, atmospheric -->\n            <g filter=\"url(#blurSoft)\" opacity=\"0.75\">\n              <ellipse cx=\"60\" cy=\"72\" rx=\"48\" ry=\"14\" fill=\"url(#cloudBand)\" />\n              <ellipse cx=\"120\" cy=\"64\" rx=\"56\" ry=\"16\" fill=\"url(#cloudBand)\" />\n              <ellipse cx=\"180\" cy=\"76\" rx=\"42\" ry=\"12\" fill=\"url(#cloudBand)\" />\n              <ellipse cx=\"90\" cy=\"82\" rx=\"36\" ry=\"10\" fill=\"#6a5090\" opacity=\"0.5\" />\n              <ellipse cx=\"150\" cy=\"86\" rx=\"40\" ry=\"11\" fill=\"#5a4080\" opacity=\"0.45\" />\n            </g>\n\n            <!-- mid haze -->\n            <ellipse cx=\"120\" cy=\"110\" rx=\"100\" ry=\"28\" fill=\"#3a2860\" opacity=\"0.25\" />\n\n            <!-- glass overlay -->\n            <rect width=\"240\" height=\"240\" fill=\"url(#glassTint)\" />\n\n            <!-- rain on glass \u2014 streaks + beads (mature, not cartoon) -->\n            <g stroke=\"url(#dropGlass)\" stroke-linecap=\"round\" fill=\"none\">\n              <line x1=\"42\" y1=\"40\" x2=\"38\" y2=\"120\" stroke-width=\"1.1\" opacity=\"0.45\" />\n              <line x1=\"68\" y1=\"28\" x2=\"62\" y2=\"148\" stroke-width=\"1.4\" opacity=\"0.55\" />\n              <line x1=\"96\" y1=\"36\" x2=\"92\" y2=\"160\" stroke-width=\"1.2\" opacity=\"0.5\" />\n              <line x1=\"128\" y1=\"24\" x2=\"126\" y2=\"170\" stroke-width=\"1.5\" opacity=\"0.6\" />\n              <line x1=\"158\" y1=\"32\" x2=\"162\" y2=\"152\" stroke-width=\"1.2\" opacity=\"0.48\" />\n              <line x1=\"186\" y1=\"44\" x2=\"192\" y2=\"130\" stroke-width=\"1.1\" opacity=\"0.42\" />\n              <line x1=\"54\" y1=\"90\" x2=\"52\" y2=\"190\" stroke-width=\"0.9\" opacity=\"0.35\" />\n              <line x1=\"110\" y1=\"100\" x2=\"108\" y2=\"200\" stroke-width=\"1\" opacity=\"0.38\" />\n              <line x1=\"172\" y1=\"95\" x2=\"176\" y2=\"195\" stroke-width=\"0.9\" opacity=\"0.35\" />\n            </g>\n\n            <!-- water beads on glass -->\n            <g fill=\"#e8dcf8\">\n              <ellipse cx=\"74\" cy=\"108\" rx=\"2.2\" ry=\"3.4\" opacity=\"0.55\" />\n              <ellipse cx=\"118\" cy=\"132\" rx=\"2.8\" ry=\"4.2\" opacity=\"0.65\" />\n              <ellipse cx=\"148\" cy=\"98\" rx=\"2\" ry=\"3\" opacity=\"0.5\" />\n              <ellipse cx=\"98\" cy=\"168\" rx=\"2.4\" ry=\"3.6\" opacity=\"0.58\" />\n              <ellipse cx=\"164\" cy=\"156\" rx=\"2.1\" ry=\"3.2\" opacity=\"0.52\" />\n              <ellipse cx=\"56\" cy=\"152\" rx=\"1.8\" ry=\"2.8\" opacity=\"0.45\" />\n              <ellipse cx=\"190\" cy=\"118\" rx=\"2\" ry=\"3\" opacity=\"0.48\" />\n              <circle cx=\"76\" cy=\"106\" r=\"0.8\" fill=\"#ffffff\" opacity=\"0.7\" />\n              <circle cx=\"117\" cy=\"130\" r=\"0.9\" fill=\"#ffffff\" opacity=\"0.75\" />\n            </g>\n\n            <!-- thin window edge \u2014 subtle frame -->\n            <rect x=\"8\" y=\"8\" width=\"224\" height=\"224\" fill=\"none\" stroke=\"#c8b0e8\" stroke-opacity=\"0.12\" stroke-width=\"1.2\" />\n            <line x1=\"120\" y1=\"8\" x2=\"120\" y2=\"232\" stroke=\"#c8b0e8\" stroke-opacity=\"0.08\" stroke-width=\"1\" />\n\n            <!-- soft reflection / bottom vignette -->\n            <ellipse cx=\"120\" cy=\"220\" rx=\"90\" ry=\"18\" fill=\"#080414\" opacity=\"0.55\" />\n          </svg>\n        </div>"}